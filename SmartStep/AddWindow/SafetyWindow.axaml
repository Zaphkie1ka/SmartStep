<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" Width="600" Height="400" Background="#FAEBD7"
        x:Class="SmartStep.SafetyWindow"
        Title="Инструктажи">
    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
        <Label Content="Инструктаж по ТБ" HorizontalAlignment="Center" FontSize="26" Margin="0,10,0,10"></Label>
        <StackPanel Orientation="Horizontal">
            <Label Content="Название" Margin="5" VerticalContentAlignment="Center"></Label>
            <TextBox x:Name="textBoxName" Watermark="Вводный инструктаж" Width="300" Margin="60,5,0,5"></TextBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <Label Content="Описание" Margin="5" VerticalContentAlignment="Top"></Label>
            <TextBox x:Name="textBoxDescription" Watermark="Краткое описание" Width="300" Height="120"
                     AcceptsReturn="True" TextWrapping="Wrap" Margin="64,5,0,5"></TextBox>
        </StackPanel>
        <Panel>
            <Button Margin="20" Content="Добавить" Width="100" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Click="Add_Button"></Button>
            <Button Margin="20" Content="Закрыть" Width="100" HorizontalContentAlignment="Center" HorizontalAlignment="Right" Click="Ext_Button"></Button>
        </Panel>
    </StackPanel>
</Window>
